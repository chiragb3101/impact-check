{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Impact findings",
  "description": "Written by the Copilot agent after investigating a branch. Rendered by `impact report`.",
  "type": "object",
  "required": ["branch", "base", "summary", "risk", "changes", "callers", "tests"],
  "additionalProperties": false,
  "properties": {
    "branch": {"type": "string"},
    "base": {"type": "string"},
    "summary": {"type": "string", "minLength": 10, "description": "Two or three plain sentences: is this safe to merge and why."},
    "risk": {
      "type": "object",
      "required": ["level", "reasons"],
      "additionalProperties": false,
      "properties": {
        "level": {"enum": ["high", "medium", "low"]},
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "file", "kind", "description"],
        "additionalProperties": false,
        "properties": {
          "symbol": {"type": "string"},
          "file": {"type": "string"},
          "kind": {"enum": ["behavior_change", "refactor", "signature_change", "new", "deleted", "schema_change", "config_change"]},
          "description": {"type": "string"}
        }
      }
    },
    "callers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caller", "file", "verdict", "reason"],
        "additionalProperties": false,
        "properties": {
          "caller": {"type": "string"},
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "for_symbol": {"type": "string"},
          "verdict": {"enum": ["breaks", "safe", "unclear"]},
          "reason": {"type": "string"}
        }
      }
    },
    "tests": {
      "type": "object",
      "required": ["selected", "results"],
      "additionalProperties": false,
      "properties": {
        "selected": {"type": "integer", "minimum": 0},
        "total_in_index": {"type": "integer", "minimum": 0},
        "seconds": {"type": "number", "minimum": 0},
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["test", "status"],
            "additionalProperties": false,
            "properties": {
              "test": {"type": "string"},
              "status": {"enum": ["passed", "failed", "error", "skipped"]},
              "message": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "missing_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "additionalProperties": false,
        "properties": {
          "description": {"type": "string"},
          "generated_test": {
            "type": "object",
            "required": ["path", "status"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string"},
              "status": {"enum": ["passed", "failed", "error", "not_run"]},
              "confirms_risk": {"type": "boolean"},
              "note": {"type": "string"}
            }
          }
        }
      }
    },
    "schema_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "severity"],
        "additionalProperties": false,
        "properties": {
          "description": {"type": "string"},
          "severity": {"enum": ["high", "medium", "low"]},
          "affected_code": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "suggested_fixes": {"type": "array", "items": {"type": "string"}},
    "agent_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "detail"],
        "additionalProperties": false,
        "properties": {
          "action": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
